# ===== CareSync AI v2 — copy to .env and fill in. NEVER commit .env =====
APP_ENV=production
# python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=

WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com,api

POSTGRES_PASSWORD=
REDIS_PASSWORD=
# For managed cloud services, set these directly instead (compose values are overridden):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/caresync?sslmode=require
# REDIS_URL=rediss://:pass@host:6380/0

STORAGE_BACKEND=s3
S3_BUCKET=caresync-private
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_KMS_SECRET_KEY=caresync-key:REPLACE_WITH_BASE64_32_BYTES
# S3_ENDPOINT_URL=          # blank for AWS; set for GCS/Azure/other S3-compatible
# S3_KMS_KEY_ID=            # customer-managed KMS key (recommended)

DATA_REGION=eu-west-1
DEFAULT_TIMEZONE=UTC
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REQUIRE_MFA_FOR_STAFF=true
ALLOW_CLINICIAN_SELF_SIGNUP=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_MB=12
SEED_DEMO=false

# Optional OpenAI-compatible AI provider (requires a data-processing agreement)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional HTTPS webhook for alerts (receives IDs + severity only, no names)
ALERT_WEBHOOK_URL=
